# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_ID=123456789

# Wallbit Public API Configuration (una instancia y una API key local)
WALLBIT_API_KEY=your_wallbit_api_key_here
WALLBIT_BASE_URL=https://api.wallbit.io
# Plan para estimar la comisión de compra: classic (0.40%), pro (0.35%) o max (0.30%, tope 10 USD).
# Es una estimación local; Wallbit cobra la tarifa real según el plan de la cuenta.
WALLBIT_PLAN=classic
# Caché corta de cotizaciones/metadata; no se usa para confirmar órdenes.
WALLBIT_CACHE_TTL_SECONDS=5

# Database
DATABASE_URL=sqlite:///wallbit.db

# User Defaults
DEFAULT_CURRENCY=CLP
DEFAULT_TIMEZONE=America/Santiago
DEFAULT_REPORT_TIME=09:00

# Trading Mode: false = simulation / dry-run (safe); true = real orders
TRADING_ENABLED=false

# IA opcional; no habilita compras ni ventas.
AI_ENABLED=false
AI_PROVIDER=mock
WALLSYNC_ENABLED=false

# Caché de tipos de cambio en segundos.
FX_CACHE_TTL_SECONDS=300

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Scheduler Intervals (minutes)
ALERT_CHECK_INTERVAL_MINUTES=5
DCA_CHECK_INTERVAL_MINUTES=1
ORDER_EXPIRY_HOURS=24
